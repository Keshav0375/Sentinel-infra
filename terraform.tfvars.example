# Local run values. CI passes these as -var flags instead (C5: never TF_VAR_*).
#
# `layer` has no default deliberately — it decides whether a run manages the
# shared platform or one deployment, and defaulting that is how someone applies
# the wrong one.
layer           = "platform"
subscription_id = "<your-subscription-id>"

pg_admin_object_id      = "<az ad signed-in-user show --query id -o tsv>"
pg_admin_principal_name = "<your-upn>"
